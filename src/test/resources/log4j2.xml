<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>

        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss} [%t] %-5level %logger - %msg%n"/>
        </Console>

        <RollingFile name="FileLogger"
                     fileName="test-output/logs/automation.log"
                     filePattern="test-output/logs/automation-%d{yyyyMMdd_HHmmss}.log">

            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} %-5level %logger - %msg%n"/>

            <Policies>
                <OnStartupTriggeringPolicy/>
            </Policies>
            
            <DefaultRolloverStrategy max="20"/>

        </RollingFile>

    </Appenders>

    <Loggers>
        <Root level="info">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="FileLogger"/>
        </Root>
    </Loggers>
</Configuration>